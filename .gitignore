.venv/
manual/.venv/
manual/.venv-docx/
# Java Desktop ネットワークソース代替キャッシュ（リポジトリ直下 .pm-ai-cache/）。無視しない — Git のステージング対象。
# Log files（ステージングしない。execution_log.txt は実行ごとに肥大化するため Git 対象外）
/log/
log/execution_log.txt
*.log
# Excel creates lock files while a workbook is open
**/~$*

# Build / cache（ステージングしない）
/preview_cache/
code_java/target/
code_java/build_cache/
code_java/package_input/
code_java/package_input_rdp/
code_java/dist/
**/__pycache__/
**/.pytest_cache/
# fast_package_app.ps1: release output (PMD_* bundles under repo root). Download cache: code_java/Cash_PMD/
pm-ai-package-release/
rpa_luncher_release/
/cash_PMD/
/code_java/PMD_fast/
/code_java/Cash_PMD/

# 国分 PMD 初期一式の jlink イメージ（GitHub 100MB 制限超のため履歴に含めない）
国分工場_実行環境/PMD_initial_install/runtime/lib/modules

# JVM heap dumps（コミットしない）
*.hprof
*.hprof.*
*.lock
stage1_task_input_table.xlsx

# 生成物の実行出力（段階1/2/3 の xlsx・json）。再生成可能なためコミットしない
/output/

# 操作者名・PIN ストア（個人情報を含む可能性。コミットしない）

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jp.co.pm.ai.desktop.MachineCalendarTabController"
      spacing="12.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <children>
        <VBox fx:id="monthCalendarHost" spacing="4.0"/>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <ToolBar>
                <Label text="セル"/>
                <Spinner fx:id="cellSizeSpinner" editable="true" prefWidth="52.0"/>
                <Button fx:id="importMasterButton" text="master から取込" onAction="#onImportFromMaster"/>
                <Button fx:id="saveButton" text="保存" onAction="#onSave"/>
                <Separator/>
                <Button fx:id="refreshButton" text="再読込" onAction="#onRefresh"/>
            </ToolBar>
            <Label fx:id="statusLabel" text=""/>
            <Label wrapText="true"
                   text="正本: machine-calendar-data.json（サマリ Excel 同階層）。master.xlsm「機械カレンダー」は互換用（将来廃止）。"/>
            <VBox fx:id="gridHost" spacing="4.0"/>
        </VBox>
    </children>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import jp.co.pm.ai.desktop.ProcessingTrendNumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="tabRoot" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jp.co.pm.ai.desktop.ProcessingFeeTrendTabController"
            styleClass="pm-processing-fee-trend-tab-root">
    <top>
        <VBox spacing="4.0">
            <ToolBar>
                <Button fx:id="reloadButton" mnemonicParsing="false" onAction="#onReloadAction" text="再読込"/>
                <Separator orientation="VERTICAL"/>
                <Label text="期間"/>
                <ComboBox fx:id="periodPresetCombo" prefWidth="118.0"/>
                <DatePicker fx:id="fromDatePicker" prefWidth="132.0"/>
                <Label text="〜"/>
                <DatePicker fx:id="toDatePicker" prefWidth="132.0"/>
                <Button fx:id="thisMonthButton" mnemonicParsing="false" onAction="#onThisMonthAction" text="今月"/>
                <Separator orientation="VERTICAL"/>
                <HBox fx:id="loadingChip" alignment="CENTER_LEFT" spacing="6.0" styleClass="pm-processing-fee-trend-loading-chip" visible="false" managed="false">
                    <ProgressIndicator fx:id="loadingIndicator" prefHeight="18.0" prefWidth="18.0"/>
                    <Label fx:id="loadingStatusLabel" styleClass="pm-processing-fee-trend-muted" text="読込中…"/>
                </HBox>
            </ToolBar>
            <FlowPane hgap="14.0" vgap="6.0">
                <padding>
                    <Insets bottom="4.0" left="8.0" right="8.0" top="2.0"/>
                </padding>
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="実績"/>
                    <ComboBox fx:id="actualSourceCombo" prefWidth="160.0"/>
                    <Label text="予定"/>
                    <ComboBox fx:id="planSourceCombo" prefWidth="168.0"/>
                </HBox>
            </FlowPane>
            <FlowPane hgap="10.0" vgap="8.0" styleClass="pm-processing-fee-trend-kpi-row">
                <padding>
                    <Insets bottom="4.0" left="8.0" right="8.0" top="0.0"/>
                </padding>
                <VBox styleClass="pm-processing-fee-trend-kpi-card">
                    <Label styleClass="pm-processing-fee-trend-kpi-caption" text="実績円合計（期間）"/>
                    <Label fx:id="kpiActualYen" styleClass="pm-processing-fee-trend-kpi-value" text="—"/>
                </VBox>
                <VBox styleClass="pm-processing-fee-trend-kpi-card">
                    <Label styleClass="pm-processing-fee-trend-kpi-caption" text="予定円合計（期間）"/>
                    <Label fx:id="kpiPlanYen" styleClass="pm-processing-fee-trend-kpi-value" text="—"/>
                </VBox>
            </FlowPane>
            <HBox fx:id="noticeBanner" managed="false" visible="false" styleClass="pm-processing-fee-trend-banner">
                <padding>
                    <Insets bottom="4.0" left="8.0" right="8.0" top="0.0"/>
                </padding>
                <Label fx:id="noticeLabel" wrapText="true"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="4.0">
            <padding>
                <Insets bottom="4.0" left="8.0" right="8.0" top="0.0"/>
            </padding>
            <Label fx:id="chartTitleLabel" styleClass="pm-processing-fee-trend-chart-title" text="加工賃トレンド（円）"/>
            <StackPane fx:id="chartStack" VBox.vgrow="ALWAYS" maxWidth="1300.0" maxHeight="600.0"
                       styleClass="pm-processing-fee-trend-chart-stack">
                <BarChart fx:id="dailyChart" animated="false" legendVisible="false" minHeight="200.0"
                          styleClass="pm-fee-trend-daily-chart" barGap="1.0" categoryGap="8.0"
                          horizontalGridLinesVisible="true" verticalGridLinesVisible="false"
                          alternativeRowFillVisible="false" alternativeColumnFillVisible="false"
                          horizontalZeroLineVisible="false" verticalZeroLineVisible="false">
                    <xAxis>
                        <CategoryAxis fx:id="dailyXAxis" animated="false" tickLabelGap="20.0" tickLabelsVisible="true"/>
                    </xAxis>
                    <yAxis>
                        <ProcessingTrendNumberAxis fx:id="dailyYAxis" animated="false" autoRanging="false"
                                    label="日次 (円)" lowerBound="0.0" upperBound="10.0" tickUnit="2.0" minorTickVisible="false"/>
                    </yAxis>
                </BarChart>
                <Pane fx:id="markerPane" mouseTransparent="true"/>
            </StackPane>
            <Label fx:id="sourceSummaryLabel" styleClass="pm-processing-fee-trend-muted" wrapText="true" text=""/>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import jp.co.pm.ai.desktop.ProcessingTrendNumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- 加工量トレンドと同系（白地 StackPane・左右Y）。center は ScrollPane 無し（CSS 継承を加工量に揃える） -->
<BorderPane fx:id="tabRoot" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jp.co.pm.ai.desktop.ProcessingFeeTrendTabController"
            styleClass="pm-processing-trend-tab-root, pm-processing-fee-trend-tab-root">
    <top>
        <VBox spacing="4.0">
            <ToolBar>
                <Button fx:id="reloadButton" mnemonicParsing="false" onAction="#onReloadAction" text="再読込"/>
                <Separator orientation="VERTICAL"/>
                <Label text="期間"/>
                <ComboBox fx:id="periodPresetCombo" prefWidth="118.0"/>
                <DatePicker fx:id="fromDatePicker" prefWidth="132.0"/>
                <Label text="〜"/>
                <DatePicker fx:id="toDatePicker" prefWidth="132.0"/>
                <Button fx:id="thisMonthButton" mnemonicParsing="false" onAction="#onThisMonthAction" text="今月"/>
                <Separator orientation="VERTICAL"/>
                <HBox fx:id="loadingChip" alignment="CENTER_LEFT" spacing="6.0" styleClass="pm-processing-trend-loading-chip" visible="false" managed="false">
                    <ProgressIndicator fx:id="loadingIndicator" prefHeight="18.0" prefWidth="18.0"/>
                    <Label fx:id="loadingStatusLabel" styleClass="pm-processing-trend-muted" text="読込中…"/>
                </HBox>
            </ToolBar>
            <FlowPane hgap="14.0" vgap="6.0">
                <padding>
                    <Insets bottom="4.0" left="8.0" right="8.0" top="2.0"/>
                </padding>
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="実績"/>
                    <ComboBox fx:id="actualSourceCombo" prefWidth="160.0"/>
                    <Label text="予定"/>
                    <ComboBox fx:id="planSourceCombo" prefWidth="168.0"/>
                    <Label fx:id="planSourceMetaLabel" managed="false" visible="false"
                           styleClass="pm-processing-trend-plan-source-meta" text=""/>
                </HBox>
            </FlowPane>
            <FlowPane hgap="10.0" vgap="8.0">
                <padding>
                    <Insets bottom="4.0" left="8.0" right="8.0" top="0.0"/>
                </padding>
                <VBox styleClass="pm-processing-trend-kpi-card">
                    <Label styleClass="pm-processing-trend-kpi-caption" text="受注額合計（AO・受注月）"/>
                    <Label fx:id="kpiOrderAoYen" styleClass="pm-processing-trend-kpi-value" text="—"/>
                </VBox>
                <VBox styleClass="pm-processing-trend-kpi-card">
                    <Label styleClass="pm-processing-trend-kpi-caption" text="実績円合計（期間）"/>
                    <Label fx:id="kpiActualYen" styleClass="pm-processing-trend-kpi-value" text="—"/>
                </VBox>
                <VBox styleClass="pm-processing-trend-kpi-card">
                    <Label styleClass="pm-processing-trend-kpi-caption" text="予定円合計（期間）"/>
                    <Label fx:id="kpiPlanYen" styleClass="pm-processing-trend-kpi-value" text="—"/>
                </VBox>
            </FlowPane>
            <HBox fx:id="noticeBanner" managed="false" visible="false" styleClass="pm-processing-trend-banner, pm-processing-trend-banner-warn">
                <padding>
                    <Insets bottom="4.0" left="8.0" right="8.0" top="0.0"/>
                </padding>
                <Label fx:id="noticeLabel" wrapText="true"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="4.0">
            <padding>
                <Insets bottom="4.0" left="8.0" right="8.0" top="0.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" maxWidth="1300.0" spacing="14.0" styleClass="pm-processing-trend-legend-row">
                <Label fx:id="chartTitleLabel" styleClass="pm-processing-trend-chart-title" text="加工賃トレンド（円）"/>
                <HBox fx:id="legendBox" alignment="CENTER_LEFT" spacing="16.0" styleClass="pm-processing-trend-legend"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label styleClass="pm-processing-trend-muted" text="単位: 円（AO÷最終工程m）"/>
            </HBox>
            <StackPane fx:id="chartStack" VBox.vgrow="ALWAYS" maxWidth="1300.0" maxHeight="600.0"
                       styleClass="pm-processing-trend-chart-stack">
                <BarChart fx:id="dailyChart" animated="false" legendVisible="false" minHeight="200.0"
                          styleClass="pm-trend-daily-chart" barGap="1.0" categoryGap="8.0"
                          horizontalGridLinesVisible="true" verticalGridLinesVisible="false"
                          alternativeRowFillVisible="false" alternativeColumnFillVisible="false"
                          horizontalZeroLineVisible="false" verticalZeroLineVisible="false">
                    <xAxis>
                        <CategoryAxis fx:id="dailyXAxis" animated="false" tickLabelGap="20.0" tickLabelsVisible="false"/>
                    </xAxis>
                    <yAxis>
                        <ProcessingTrendNumberAxis fx:id="dailyYAxis" animated="false" autoRanging="false"
                                    label="日次 (円) ─ 棒" lowerBound="0.0" upperBound="10.0" tickUnit="2.0" minorTickVisible="false"/>
                    </yAxis>
                </BarChart>
                <!-- 注意: Chart は @NamedArg 経由（ProxyBuilder）で生成されるため styleClass のカンマ区切りは分割されない。
                     単一クラスのみ書き、pm-trend-overlay は Controller が付与する -->
                <LineChart fx:id="cumulativeChart" animated="false" createSymbols="false" legendVisible="false"
                           minHeight="200.0" styleClass="pm-trend-cumulative-chart"
                           mouseTransparent="true"
                           horizontalGridLinesVisible="false" verticalGridLinesVisible="false"
                           alternativeRowFillVisible="false" alternativeColumnFillVisible="false"
                           horizontalZeroLineVisible="false" verticalZeroLineVisible="false">
                    <xAxis>
                        <CategoryAxis fx:id="cumulativeXAxis" animated="false" tickLabelGap="20.0" tickLabelsVisible="false"/>
                    </xAxis>
                    <yAxis>
                        <ProcessingTrendNumberAxis fx:id="cumulativeYAxis" animated="false" autoRanging="false"
                                    label="累計 (円) ─ 折れ線"
                                    lowerBound="0.0" upperBound="10.0" tickUnit="2.0" minorTickVisible="false" side="RIGHT"/>
                    </yAxis>
                </LineChart>
                <Pane fx:id="markerPane" mouseTransparent="true" styleClass="pm-processing-trend-marker-pane"/>
            </StackPane>
            <Label fx:id="sourceSummaryLabel" maxWidth="1300.0" styleClass="pm-processing-trend-source"
                   text="" wrapText="true"/>
            <TitledPane fx:id="detailPane" animated="false" collapsible="true" expanded="false" maxWidth="1300.0" text="日別集計（円）">
                <TableView fx:id="detailTable" fixedCellSize="24.0" prefHeight="220.0" maxHeight="320.0"
                           styleClass="pm-processing-trend-detail-table">
                    <columns>
                        <TableColumn fx:id="colDate" prefWidth="110.0" sortable="false" text="日付"/>
                        <TableColumn fx:id="colActualYen" prefWidth="120.0" sortable="false" text="実績円"/>
                        <TableColumn fx:id="colPlanYen" prefWidth="120.0" sortable="false" text="予定円"/>
                        <TableColumn fx:id="colActualCumYen" prefWidth="130.0" sortable="false" text="実績累計円"/>
                        <TableColumn fx:id="colPlanCumYen" prefWidth="130.0" sortable="false" text="予定累計円"/>
                    </columns>
                </TableView>
            </TitledPane>
            <TitledPane fx:id="requestPane" animated="false" collapsible="true" expanded="false" maxWidth="1300.0" text="依頼NO別 加工賃">
                <TableView fx:id="requestTable" fixedCellSize="24.0" prefHeight="260.0" maxHeight="400.0"
                           styleClass="pm-processing-trend-detail-table">
                    <columns>
                        <TableColumn fx:id="colRequestNo" prefWidth="140.0" sortable="true" text="依頼NO"/>
                        <TableColumn fx:id="colAoYen" prefWidth="120.0" sortable="true" text="AO(受注額)"/>
                        <TableColumn fx:id="colRateYen" prefWidth="100.0" sortable="true" text="円/m"/>
                        <TableColumn fx:id="colActualM" prefWidth="100.0" sortable="true" text="実績 (m)"/>
                        <TableColumn fx:id="colPlanM" prefWidth="100.0" sortable="true" text="予定 (m)"/>
                        <TableColumn fx:id="colReqActualYen" prefWidth="120.0" sortable="true" text="実績円"/>
                        <TableColumn fx:id="colReqPlanYen" prefWidth="120.0" sortable="true" text="予定円"/>
                    </columns>
                </TableView>
            </TitledPane>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      spacing="10.0"
      fx:controller="jp.co.pm.ai.desktop.OperatorUserManagementTabController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <Label styleClass="pm-section-title" text="ユーザー管理者（操作者名・PIN）"
           wrapText="true"/>
    <Label text="工場ごとに配台システム起動時の名前選択肢と PIN（4～10 桁）を管理します。ユーザーは実行・ログタブから自分の PIN を変更できます。設定はサマリ Excel と同じフォルダのバイナリファイル（factory-operator-users.bin）に保存されます。PIN を 20 回連続で間違えるとロックされます。"
           wrapText="true"/>
    <Separator/>
    <Label fx:id="factoryLabel" styleClass="pm-muted-label" wrapText="true"/>
    <Label fx:id="sessionOperatorLabel" wrapText="true"/>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Button fx:id="changeSessionOperatorButton" mnemonicParsing="false"
                onAction="#onChangeSessionOperatorAction" text="現在の操作者を変更"/>
    </HBox>
    <Separator/>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="追加する名前"/>
        <TextField fx:id="newNameField" prefWidth="240.0" promptText="例: 山田"/>
        <Button fx:id="addNameButton" mnemonicParsing="false" onAction="#onAddNameAction" text="追加"/>
        <Button fx:id="removeNameButton" mnemonicParsing="false" onAction="#onRemoveNameAction" text="選択を削除"/>
        <Button fx:id="resetDefaultsButton" mnemonicParsing="false" onAction="#onResetDefaultsAction" text="既定4名に戻す"/>
        <Button fx:id="issuePinButton" mnemonicParsing="false" onAction="#onIssuePinAction" text="PIN 発行／再発行"/>
        <Button fx:id="unlockPinButton" mnemonicParsing="false" onAction="#onUnlockPinAction" text="PIN ロック解除"/>
    </HBox>
    <Label text="ユーザー一覧（起動時の選択肢）"/>
    <TableView fx:id="operatorTableView" prefHeight="220.0" VBox.vgrow="ALWAYS"/>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefreshAction" text="一覧更新"/>
    </HBox>
    <Separator/>
    <Label styleClass="pm-section-title" text="ユーザー管理バイナリのバックアップ（世代管理）"/>
    <Label text="手動で factory-operator-users.bin のバックアップを取り、一覧から選択して復元できます（管理者向け）。"
           wrapText="true"/>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="メモ"/>
        <TextField fx:id="backupLabelField" prefWidth="320.0" promptText="任意（手動バックアップ時）"/>
        <Button fx:id="createBackupButton" mnemonicParsing="false" onAction="#onCreateBackupAction" text="手動バックアップ"/>
        <Button fx:id="restoreBackupButton" mnemonicParsing="false" onAction="#onRestoreBackupAction" text="選択を復元"/>
        <Button fx:id="refreshBackupButton" mnemonicParsing="false" onAction="#onRefreshBackupAction" text="バックアップ一覧更新"/>
    </HBox>
    <Label fx:id="backupStorePathLabel" styleClass="pm-muted-label" wrapText="true"/>
    <Label text="バックアップ一覧（新しい順）"/>
    <ListView fx:id="backupListView" prefHeight="160.0"/>
</VBox>

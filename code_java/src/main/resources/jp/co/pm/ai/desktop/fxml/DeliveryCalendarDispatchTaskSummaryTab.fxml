<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- 納期管理ビュー: 配台結果をタスク1行集約し、依頼NO先頭英字でタブ分割 -->
<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jp.co.pm.ai.desktop.DeliveryCalendarDispatchTaskSummaryTabController"
      fillWidth="true" maxHeight="Infinity" spacing="8.0">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <TitledPane animated="true" expanded="true"
                text="&#x64cd;&#x4f5c;&#x30fb;&#x30bd;&#x30fc;&#x30b9;">
        <content>
            <VBox fillWidth="true" spacing="8.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <padding>
                        <Insets bottom="4.0"/>
                    </padding>
                    <Label fx:id="dataStageBadgeLabel" styleClass="pm-planning-stage-badge"
                           text="&#x6bb5;&#x968e;2" visible="false" managed="false"/>
                    <Button fx:id="refreshButton" mnemonicParsing="false" text="再読み"
                            onAction="#onRefreshButtonAction"/>
                    <Button mnemonicParsing="false" text="列フィルタ・並べ替え解除"
                            onAction="#onClearColumnFiltersAction"/>
                    <Label text="並び"/>
                    <ComboBox fx:id="sortColumnCombo" prefWidth="160.0"/>
                    <ToggleButton fx:id="sortDescendingToggle" mnemonicParsing="false"
                                  text="降順"/>
                    <Label fx:id="statusLabel"/>
                </HBox>
                <Label fx:id="pathLabel" wrapText="true"/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="データ行の高さ（一括）"/>
                    <Slider fx:id="rowHeightSlider" blockIncrement="25.0" majorTickUnit="250.0"
                            max="2000.0" min="50.0" prefWidth="240.0" showTickMarks="true"/>
                    <Label fx:id="rowHeightPctLabel" minWidth="52.0" text="100%"/>
                    <CheckBox fx:id="cellWrapCheck" mnemonicParsing="false"
                              text="長い文字列を折り返す"/>
                </HBox>
                <HBox fx:id="columnStripHost" spacing="0.0"/>
            </VBox>
        </content>
    </TitledPane>
    <TitledPane animated="true" expanded="true" maxHeight="Infinity"
                text="&#x30c7;&#x30fc;&#x30bf;&#x8868;" VBox.vgrow="ALWAYS">
        <content>
            <VBox fillWidth="true" maxHeight="Infinity" spacing="6.0">
                <TabPane fx:id="prefixTabPane" tabClosingPolicy="UNAVAILABLE"/>
                <SplitPane dividerPositions="0.75" maxHeight="Infinity" minHeight="240.0"
                           orientation="HORIZONTAL" VBox.vgrow="ALWAYS">
                    <StackPane fx:id="spreadsheetHost" minHeight="240.0"/>
                    <VBox fx:id="dailySchedulePane" fillWidth="true" maxWidth="Infinity"
                          minHeight="240.0" minWidth="180.0" spacing="4.0">
                        <Label fx:id="dailyScheduleTitleLabel" style="-fx-font-weight: bold;"
                               text="配台予定（日別）" wrapText="true"/>
                        <TableView fx:id="dailyScheduleTable" maxHeight="Infinity"
                                   maxWidth="Infinity" minHeight="120.0" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </SplitPane>
            </VBox>
        </content>
    </TitledPane>
</VBox>

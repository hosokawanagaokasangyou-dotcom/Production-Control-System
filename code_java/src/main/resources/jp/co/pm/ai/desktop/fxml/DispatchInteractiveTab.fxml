<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableView?>
<?import org.controlsfx.control.spreadsheet.SpreadsheetView?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jp.co.pm.ai.desktop.DispatchInteractiveTabController"
      fillWidth="true" spacing="8.0" styleClass="pm-dispatch-interactive-tab">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <VBox spacing="6.0">
        <HBox alignment="CENTER_LEFT" fillHeight="false" spacing="8.0" styleClass="pm-dispatch-toolbar-row">
            <Button fx:id="loadButton" minWidth="-1.0" mnemonicParsing="false" text="再読み込み"
                    onAction="#onLoadAction"/>
            <Button minWidth="-1.0" mnemonicParsing="false" text="列フィルタ・並べ替え解除"
                    onAction="#onClearColumnFiltersAction"/>
            <Button minWidth="-1.0" mnemonicParsing="false" text="列の並べ替え"
                    onAction="#onColumnReorderAction"/>
            <Button minWidth="-1.0" mnemonicParsing="false" text="列の表示"
                    onAction="#onColumnVisibilityAction"/>
            <Label minWidth="-1.0" text="表示開始:"/>
            <Label minWidth="-1.0" text="当日"/>
            <Spinner fx:id="dateAxisPastDaysSpinner" editable="true" prefWidth="72.0">
                <tooltip>
                    <Tooltip text="日付列の左端を本日から何日前まで広げるか（0＝本日のみ）"/>
                </tooltip>
            </Spinner>
            <Label minWidth="-1.0" text="日前"/>
            <Label minWidth="-1.0" text="数量表示:"/>
            <CheckBox fx:id="showAladdinPlanQtyLineCheck" minWidth="-1.0" mnemonicParsing="false"
                      selected="true" text="(アラ計画)">
                <tooltip>
                    <Tooltip text="日付セル内の (アラ計画) 行の表示/非表示"/>
                </tooltip>
            </CheckBox>
            <CheckBox fx:id="showStage2PlanQtyLineCheck" minWidth="-1.0" mnemonicParsing="false"
                      selected="true" text="(段階2後)">
                <tooltip>
                    <Tooltip text="日付セル内の (段階2後) 行（段階2.1 比較時など）の表示/非表示"/>
                </tooltip>
            </CheckBox>
            <CheckBox fx:id="showStage21AfterQtyLineCheck" minWidth="-1.0" mnemonicParsing="false"
                      selected="true" text="(段階2.1後)">
                <tooltip>
                    <Tooltip text="日付セル内の (段階2.1後) 行の表示/非表示（段階2.1残業シミュ試行後）"/>
                </tooltip>
            </CheckBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" minWidth="-1.0" wrapText="true"/>
            <ProgressIndicator fx:id="busyIndicator" prefHeight="22.0" prefWidth="22.0"
                               visible="false" managed="false"/>
            <ProgressBar fx:id="reloadProgressBar" maxWidth="Infinity" prefWidth="220.0"
                         visible="false" managed="false"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" fillHeight="false" spacing="8.0" styleClass="pm-dispatch-toolbar-row">
            <Button fx:id="saveButton" minWidth="-1.0" mnemonicParsing="false"
                    text="保存 (JSON+xlsx)"
                    styleClass="pm-dispatch-save-button"
                    onAction="#onSaveAction">
                <tooltip>
                    <Tooltip text="配台表を 結果_配台表.json と Excel (.xlsx) に保存します"/>
                </tooltip>
            </Button>
            <Button fx:id="wideRowUpButton" minWidth="-1.0" mnemonicParsing="false" text="↑"
                    onAction="#onWideRowUpAction">
                <tooltip>
                    <Tooltip text="選択行を上へ（試行順）"/>
                </tooltip>
            </Button>
            <Button fx:id="wideRowDownButton" minWidth="-1.0" mnemonicParsing="false" text="↓"
                    onAction="#onWideRowDownAction">
                <tooltip>
                    <Tooltip text="選択行を下へ（試行順）"/>
                </tooltip>
            </Button>
            <Button fx:id="dispatchReplayButton" minWidth="-1.0" mnemonicParsing="false"
                    text="配台リプレイ" onAction="#onDispatchReplayAction">
                <tooltip>
                    <Tooltip text="配台完了後、結果_配台表.json を加工開始日時順に並べ、ワイド表のセルを順次ハイライト再生する"/>
                </tooltip>
            </Button>
            <Button fx:id="dispatchReplayStopButton" minWidth="-1.0" mnemonicParsing="false"
                    text="停止" disable="true" onAction="#onDispatchReplayStopAction"/>
            <Label text="速度"/>
            <Slider fx:id="dispatchReplaySpeedSlider" min="60.0" max="800.0" value="300.0"
                    prefWidth="120.0" majorTickUnit="200.0" blockIncrement="40.0">
                <tooltip>
                    <Tooltip text="1ステップの間隔(ms)。小さいほど速い"/>
                </tooltip>
            </Slider>
        </HBox>
    </VBox>
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label fx:id="dispatchPlanningStageBadgeLabel" styleClass="pm-planning-stage-badge"
               visible="false" managed="false"/>
        <Label fx:id="jsonPathLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>
    <VBox fx:id="stage21AttendanceApplyPanel" fillWidth="true" spacing="4.0" visible="false" managed="false"
          styleClass="stage21-attendance-apply-panel">
        <Label fx:id="stage21AttendanceHeadlineLabel" styleClass="stage21-attendance-apply-headline"
               text="段階2.1 勤怠適用済"/>
        <Label fx:id="stage21AttendanceSummaryLabel" wrapText="true"/>
        <Label fx:id="stage21AttendanceOverridesLabel" wrapText="true" style="-fx-font-size: 11px;"/>
        <Label fx:id="stage21AttendancePythonLabel" wrapText="true" style="-fx-font-size: 11px;"/>
        <Label fx:id="stage21AttendanceAppliedAtLabel" wrapText="true" style="-fx-font-size: 11px;"/>
    </VBox>
    <VBox fx:id="dispatchShortfallPanel" fillWidth="true" spacing="6.0" visible="false" managed="false">
        <Label style="-fx-font-weight: bold;" text="配台数量未達（タイムライン実績）"/>
        <TableView fx:id="dispatchShortfallTable" maxHeight="240.0" minHeight="120.0" prefHeight="160.0"/>
    </VBox>
    <TabPane fx:id="innerTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab closable="false" text="タスク×日付">
                <content>
                    <BorderPane>
                        <top>
                            <HBox fx:id="wideColumnStripHost" spacing="0.0">
                                <padding>
                                    <Insets bottom="4.0" left="0.0" right="0.0" top="0.0"/>
                                </padding>
                            </HBox>
                        </top>
                        <center>
                            <StackPane fx:id="wideSpreadsheetHost" maxHeight="Infinity" maxWidth="Infinity"
                                       minHeight="200.0"/>
                        </center>
                    </BorderPane>
                </content>
            </Tab>
            <Tab closable="false" text="工程+機械×日">
                <content>
                    <BorderPane>
                        <top>
                            <HBox fx:id="byDayColumnStripHost" spacing="0.0">
                                <padding>
                                    <Insets bottom="4.0" left="0.0" right="0.0" top="0.0"/>
                                </padding>
                            </HBox>
                        </top>
                        <center>
                            <StackPane fx:id="byDaySpreadsheetHost" maxHeight="Infinity" maxWidth="Infinity"
                                       minHeight="200.0"/>
                        </center>
                    </BorderPane>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jp.co.pm.ai.desktop.kouchin.KouchinVerifyTabController">
    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="12.0" right="12.0" top="8.0"/>
            </padding>
            <Label fx:id="diffHintLabel" wrapText="true"
                   text="後加工工賃＝①東レCSV・②明細・③アラジンの月次突合です。加工トレンド（日次の加工量・加工賃）とは別機能です。"/>
            <Label fx:id="dropTargetLabel" wrapText="true"
                   text="①東レCSVの取り込み先: （参照先タブで指定）"/>
            <HBox spacing="8.0">
                <Button fx:id="runKokubuButton" mnemonicParsing="false" onAction="#onRunKokubu" text="国分工場を検証"/>
                <Button fx:id="runKonanButton" mnemonicParsing="false" onAction="#onRunKonan" text="湖南工場を検証"/>
                <Button fx:id="runBothButton" mnemonicParsing="false" onAction="#onRunBoth" text="まとめて検証（国分→湖南）"/>
                <Label fx:id="outputWriteBlockBadge" managed="false" visible="false"
                       styleClass="pm-kouchin-output-write-block-badge" text="Excel書込不可"/>
                <Button fx:id="importCsvButton" mnemonicParsing="false" onAction="#onImportCsv" text="CSVを取り込む…"/>
                <Button fx:id="openKokubuExcelButton" mnemonicParsing="false" onAction="#onOpenKokubuExcel" text="国分のExcelを開く"/>
                <Button fx:id="openKonanExcelButton" mnemonicParsing="false" onAction="#onOpenKonanExcel" text="湖南のExcelを開く"/>
                <Button fx:id="openFolderButton" mnemonicParsing="false" onAction="#onOpenFolder" text="出力フォルダを開く"/>
                <Button fx:id="copyMailButton" mnemonicParsing="false" onAction="#onCopyMail" text="メールをコピー"/>
                <Button fx:id="gotoRdpButton" mnemonicParsing="false" onAction="#onGotoRdp" text="RDPタブへ移動"/>
            </HBox>
            <Label fx:id="statusLabel" text="まだ検証していません"/>
            <Label fx:id="kpiLabel" wrapText="true" text=""/>
            <HBox spacing="8.0">
                <Label text="判定フィルタ"/>
                <ComboBox fx:id="judgeFilterCombo" prefWidth="160.0"/>
                <Label text="検索"/>
                <TextField fx:id="searchField" prefWidth="220.0"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="6.0">
            <padding>
                <Insets left="12.0" right="12.0"/>
            </padding>
            <Label text="検出した①②③"/>
            <TableView fx:id="discoveryTable" prefHeight="160.0" minHeight="160.0" fixedCellSize="24.0"/>
            <Label text="検証A（契約NO） / 検証B（依頼NO）"/>
            <TableView fx:id="resultTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
    <bottom>
        <VBox spacing="4.0">
            <padding>
                <Insets bottom="8.0" left="12.0" right="12.0" top="4.0"/>
            </padding>
            <Label text="報告メール（国分→湖南の統合）"/>
            <TextArea fx:id="mailArea" prefRowCount="8" wrapText="true" editable="false"/>
            <Label text="ログ"/>
            <TextArea fx:id="logArea" prefRowCount="5" wrapText="true" editable="false"/>
        </VBox>
    </bottom>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      spacing="10.0" fillWidth="true" maxWidth="Infinity"
      fx:controller="jp.co.pm.ai.desktop.developer.DeveloperShareBackupTabController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <Label styleClass="pm-section-title" wrapText="true" maxWidth="Infinity" text="工場共有バックアップ"/>
    <Label wrapText="true" maxWidth="Infinity"
           text="湖南・国分の共有 DATA を、このPCのローカルと各工場共有の「バックアップ」フォルダへ同時にコピーします。バックアップフォルダ自身と Excel ロックファイルは除外します。世代は5件まで残し、古いものは削除します。"/>
    <Separator/>
    <Label fx:id="localPathLabel" styleClass="pm-muted-label" wrapText="true" maxWidth="Infinity"/>
    <Label fx:id="konanSourceLabel" styleClass="pm-muted-label" wrapText="true" maxWidth="Infinity"/>
    <Label fx:id="konanSharedLabel" styleClass="pm-muted-label" wrapText="true" maxWidth="Infinity"/>
    <Label fx:id="kokubuSourceLabel" styleClass="pm-muted-label" wrapText="true" maxWidth="Infinity"/>
    <Label fx:id="kokubuSharedLabel" styleClass="pm-muted-label" wrapText="true" maxWidth="Infinity"/>
    <FlowPane hgap="8.0" vgap="6.0" maxWidth="Infinity">
        <Button fx:id="backupButton" mnemonicParsing="false" onAction="#onBackupAction" text="今すぐバックアップ">
            <tooltip><Tooltip text="湖南と国分の共有 DATA をローカルと各工場のバックアップへコピーします。実行前に確認します。"/></tooltip>
        </Button>
        <Button fx:id="openLocalButton" mnemonicParsing="false" onAction="#onOpenLocalAction" text="ローカルを開く">
            <tooltip><Tooltip text="このPCのバックアップフォルダを開きます。無ければ作成します。"/></tooltip>
        </Button>
        <Button fx:id="openKonanButton" mnemonicParsing="false" onAction="#onOpenKonanSharedAction" text="湖南共有を開く">
            <tooltip><Tooltip text="湖南共有のバックアップフォルダを開きます。無い場合は作成しません。"/></tooltip>
        </Button>
        <Button fx:id="openKokubuButton" mnemonicParsing="false" onAction="#onOpenKokubuSharedAction" text="国分共有を開く">
            <tooltip><Tooltip text="国分共有のバックアップフォルダを開きます。無い場合は作成しません。"/></tooltip>
        </Button>
        <HBox fx:id="loadingChip" alignment="CENTER_LEFT" spacing="6.0" visible="false" managed="false">
            <ProgressIndicator fx:id="loadingIndicator" prefHeight="18.0" prefWidth="18.0"/>
            <Label text="バックアップ中…"/>
        </HBox>
    </FlowPane>
    <Label fx:id="statusLabel" wrapText="true" maxWidth="Infinity"/>
    <TextArea fx:id="logArea" prefHeight="280.0" wrapText="true" editable="false" VBox.vgrow="ALWAYS"/>
</VBox>

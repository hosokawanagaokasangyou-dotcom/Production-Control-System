<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jp.co.pm.ai.desktop.RequestFormPipelineCheckTabController" fillWidth="true" spacing="8.0">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Button fx:id="refreshButton" mnemonicParsing="false" text="更新"
                onAction="#onRefreshButtonAction"/>
        <ProgressIndicator fx:id="refreshProgressIndicator" managed="false" prefHeight="22.0"
                           prefWidth="22.0" visible="false"/>
        <Label text="検索文字列"/>
        <TextField fx:id="filterField" promptText="依頼No / ユーザー" prefWidth="220.0"/>
        <Label fx:id="statusLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <CheckBox fx:id="hideNoOriginalCheck" mnemonicParsing="false"
                  text="依頼書原本が存在しないものを非表示"/>
        <CheckBox fx:id="hideOldJuchuInputCheck" mnemonicParsing="false"
                  text="受注入力日が" selected="true"/>
        <Spinner fx:id="juchuInputHideDaysSpinner" editable="true" prefWidth="72.0"/>
        <Label text="日以上前を非表示"/>
        <CheckBox fx:id="showNoAladdinCheck" mnemonicParsing="false"
                  text="アラジン計画無しを表示" selected="true"/>
        <CheckBox fx:id="showAdjustDeliveryFromTodayCheck" mnemonicParsing="false"
                  text="調整納期が当日以降のみ表示" selected="true"/>
        <CheckBox fx:id="showDailyReportIncompleteOnlyCheck" mnemonicParsing="false"
                  text="日報未了のみ表示" selected="true"/>
        <CheckBox fx:id="showRawInputMismatchOnlyCheck" mnemonicParsing="false"
                  text="原反投入日不一致のみ表示"/>
    </HBox>
    <Label fx:id="hintLabel" wrapText="true"/>
    <Label fx:id="dailyReportSourceLabel" wrapText="true"
           style="-fx-font-size: 10px; -fx-text-fill: #555555;"/>
    <VBox spacing="4.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button fx:id="copyMainTableButton" mnemonicParsing="false"
                    text="表としてコピー" onAction="#onCopyMainTableButtonAction"/>
            <Button fx:id="copyMainTableForEmailButton" mnemonicParsing="false"
                    text="メール貼り付け用" onAction="#onCopyMainTableForEmailButtonAction"/>
            <Button fx:id="copyMainTableHtmlButton" mnemonicParsing="false"
                    text="HTML形式でコピー" onAction="#onCopyMainTableHtmlButtonAction"/>
            <Button fx:id="copyMainTableCsvButton" mnemonicParsing="false"
                    text="カンマ区切りでコピー" onAction="#onCopyMainTableCsvButtonAction"/>
        </HBox>
        <HBox fx:id="mainColumnStripHost" alignment="CENTER_LEFT" spacing="0.0"/>
        <TableView fx:id="mainTable" minHeight="180.0" VBox.vgrow="ALWAYS"/>
    </VBox>
    <SplitPane dividerPositions="0.5" minHeight="160.0" prefHeight="200.0" VBox.vgrow="ALWAYS">
        <VBox spacing="4.0">
            <Label text="原反投入日 4ソース照合（アラジン／受注／目次／依頼シート）"/>
            <TableView fx:id="crossSourceTable" minHeight="120.0"/>
            <Label text="未一致・未転記項目"/>
            <TableView fx:id="mismatchTable" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="4.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="アラジン加工計画（日付×m・日報完了）"/>
                <Button fx:id="copyPlanTableButton" mnemonicParsing="false"
                        text="表としてコピー" onAction="#onCopyPlanTableButtonAction"/>
                <Button fx:id="copyPlanTableForEmailButton" mnemonicParsing="false"
                        text="メール貼り付け用" onAction="#onCopyPlanTableForEmailButtonAction"/>
            </HBox>
            <TableView fx:id="planTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Dynamic table columns remain in {@link PlanInputTabController}. -->

<VBox fillWidth="true" spacing="6.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jp.co.pm.ai.desktop.PlanInputTabController">
    <padding>
        <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
    </padding>
    <!-- 常用: 段階2 実行・読込保存・行検索（常時表示・1〜2行） -->
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <StackPane fx:id="attendanceReadinessBadgeHost" alignment="CENTER_LEFT" managed="false" styleClass="pm-attendance-readiness-badge-host" visible="false" />
        <Button fx:id="stage2RunButton" mnemonicParsing="false" onAction="#onStage2RunButtonAction"
                styleClass="pm-stage-run-button,pm-stage-run-2" text="段階2 実行" />
        <Button fx:id="stage21RunButton" mnemonicParsing="false" onAction="#onStage21RunButtonAction"
                styleClass="pm-stage-run-button,pm-stage-run-2-1" text="段階2.1(時間外)" />
        <Button fx:id="loadButton" mnemonicParsing="false" onAction="#onLoadButtonAction" text="読み込み" />
        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onSaveButtonAction" text="保存" />
        <HBox alignment="CENTER_LEFT" spacing="6.0" HBox.hgrow="ALWAYS">
            <Label text="行検索" />
            <TextField fx:id="rowSearchField" maxWidth="Infinity" promptText="列の部分一致（空欄で解除）" HBox.hgrow="ALWAYS" />
        </HBox>
    </HBox>
    <TitledPane animated="true" expanded="false" text="ファイル・詳細オプション" VBox.vgrow="NEVER">
        <content>
            <VBox fillWidth="true" spacing="6.0">
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label minWidth="48.0" text="ファイル" />
                    <TextField fx:id="pathField" HBox.hgrow="ALWAYS" />
                    <Button fx:id="browseButton" mnemonicParsing="false" onAction="#onBrowseButtonAction" text="参照…" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label minWidth="48.0" text="シート" />
                    <TextField fx:id="sheetField" prefWidth="200.0" />
                    <Button fx:id="addRowButton" mnemonicParsing="false" onAction="#onAddRowButtonAction" text="行追加" />
                    <Button fx:id="removeRowsButton" mnemonicParsing="false" onAction="#onRemoveRowsButtonAction" text="行削除" />
                    <Label text="列幅" />
                    <TextField fx:id="colWidthField" maxWidth="64.0" prefWidth="64.0" promptText="112" />
                </HBox>
                <TitledPane animated="true" expanded="false" text="段階2 実行オプション">
                    <content>
                        <VBox spacing="6.0">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <CheckBox fx:id="stage2SkipCacheClearCheckBox" mnemonicParsing="false"
                                        text="キャッシュをクリアしない">
                                    <tooltip>
                                        <Tooltip text="ON のとき段階2.0 実行前に結果_配台表・段階2/2.1 計画・人員ブック・翌日配台キャッシュ等を残したまま実行します。既定は OFF（毎回クリア）。" />
                                    </tooltip>
                                </CheckBox>
                                <CheckBox fx:id="stage2SkipGeminiApiCheckBox" mnemonicParsing="false" selected="false"
                                        text="AI API スキップ">
                                    <tooltip>
                                        <Tooltip text="ON のとき段階2/2.1 で Gemini への HTTP 呼び出しを行いません。" />
                                    </tooltip>
                                </CheckBox>
                                <CheckBox fx:id="comboSheetMayExceedNeedCheckBox" mnemonicParsing="false" selected="true"
                                        text="組み合わせ表 need 超過を許可">
                                    <tooltip>
                                        <Tooltip text="組み合わせ表の人数が need より多い場合も有効にする" />
                                    </tooltip>
                                </CheckBox>
                            </HBox>
                            <VBox alignment="TOP_LEFT" maxWidth="-1.0" spacing="6.0" styleClass="pm-option-group-panel">
                                <Label styleClass="pm-option-group-title" text="翌日配台ダイアログ" />
                                <HBox alignment="TOP_LEFT" spacing="20.0">
                                    <VBox spacing="4.0">
                                        <RadioButton fx:id="stage2NextDayDialogInProgressRadio" mnemonicParsing="false"
                                                text="加工途中タスクの翌日配台" />
                                        <RadioButton fx:id="stage2NextDayDialogBothRadio" mnemonicParsing="false" selected="true"
                                                text="①と②をまとめて設定" />
                                    </VBox>
                                    <VBox spacing="4.0">
                                        <RadioButton fx:id="stage2NextDayDialogAladdinExcludeRadio" mnemonicParsing="false"
                                                text="アラジン当日対象行の翌日配台" />
                                        <RadioButton fx:id="stage2NextDayDialogNoneRadio" mnemonicParsing="false"
                                                text="ダイアログを表示しない" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                </TitledPane>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Button mnemonicParsing="false" onAction="#onRowUpAction" prefWidth="36.0" text="↑">
                        <tooltip><Tooltip text="選択行を上へ" /></tooltip>
                    </Button>
                    <Button mnemonicParsing="false" onAction="#onRowDownAction" prefWidth="36.0" text="↓">
                        <tooltip><Tooltip text="選択行を下へ" /></tooltip>
                    </Button>
                    <Button fx:id="shiftRawInputDateMinusOneButton" mnemonicParsing="false"
                            onAction="#onShiftRawInputDateMinusOneAction" text="原反投入日−1日">
                        <tooltip><Tooltip text="全行の原反投入日を1暦日戻す" /></tooltip>
                    </Button>
                    <Button mnemonicParsing="false" text="列フィルタ解除" onAction="#onClearColumnFiltersAction" />
                </HBox>
                <HBox fx:id="columnStripHostRow" alignment="CENTER_LEFT" spacing="6.0">
                    <HBox fx:id="columnStripHost" spacing="0.0" />
                </HBox>
            </VBox>
        </content>
    </TitledPane>
    <TitledPane animated="true" expanded="true" maxHeight="1.7976931348623157E308" text="データ表" VBox.vgrow="ALWAYS">
        <content>
            <VBox fillWidth="true" spacing="4.0">
                <Label fx:id="planInputValidationWarningLabel" managed="false" visible="false" wrapText="true"
                       style="-fx-text-fill: #b71c1c; -fx-font-weight: bold;" />
                <StackPane fx:id="spreadsheetHost" minHeight="200.0" VBox.vgrow="ALWAYS" />
            </VBox>
        </content>
    </TitledPane>
</VBox>

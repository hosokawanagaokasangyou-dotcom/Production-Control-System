<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      spacing="10.0"
      fx:controller="jp.co.pm.ai.desktop.developer.DeveloperRuntimeErrorTabController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <Label styleClass="pm-section-title" text="実行時エラー" wrapText="true"/>
    <Label text="現工場の共有フォルダ remote_log を解析し、操作者・版・工場ごとの失敗行を一覧します。段階2未実行の東レ後加工賃検証も含みます。"
           wrapText="true"/>
    <Separator/>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="操作者"/>
        <ComboBox fx:id="operatorCombo" prefWidth="220.0"/>
        <Button mnemonicParsing="false" onAction="#onRefreshAction" text="再解析"/>
    </HBox>
    <Label fx:id="pathLabel" styleClass="pm-muted-label" wrapText="true"/>
    <Label fx:id="statusLabel" wrapText="true"/>
    <TableView fx:id="errorTable" prefHeight="280.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="tsColumn" text="日付" prefWidth="110.0"/>
            <TableColumn fx:id="operatorColumn" text="操作者" prefWidth="90.0"/>
            <TableColumn fx:id="versionColumn" text="版" prefWidth="70.0"/>
            <TableColumn fx:id="factoryColumn" text="工場" prefWidth="80.0"/>
            <TableColumn fx:id="eventColumn" text="種別" prefWidth="100.0"/>
            <TableColumn fx:id="severityColumn" text="重要度" prefWidth="70.0"/>
            <TableColumn fx:id="excerptColumn" text="摘要" prefWidth="360.0"/>
        </columns>
    </TableView>
    <Label text="選択行の詳細"/>
    <TextArea fx:id="detailArea" prefHeight="120.0" wrapText="true" editable="false"/>
</VBox>

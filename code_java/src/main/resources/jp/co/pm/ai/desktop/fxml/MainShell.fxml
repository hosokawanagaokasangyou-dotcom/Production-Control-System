<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<!-- UI 文言は UTF-8 の日本語リテラル（XML 宣言の encoding と一致）。 -->
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="pm-shell"
            prefWidth="2160.0" prefHeight="850.0"
            fx:controller="jp.co.pm.ai.desktop.MainShellController">
    <top>
        <ToolBar styleClass="pm-app-toolbar">
            <StackPane fx:id="shellFactoryLogoHost" alignment="CENTER" maxHeight="24.0" minHeight="22.0"
                       prefHeight="22.0" styleClass="pm-run-factory-logo-host">
                <ImageView fx:id="shellFactoryLogoImageView" fitHeight="18.0" fitWidth="72.0"
                           mouseTransparent="true" preserveRatio="true"/>
                <Label fx:id="shellFactoryLogoCaptionLabel" alignment="CENTER" contentDisplay="CENTER"
                       maxWidth="80.0" mouseTransparent="true" styleClass="pm-run-factory-logo-caption"
                       text="" textAlignment="CENTER" wrapText="false"/>
            </StackPane>
            <ComboBox fx:id="shellFactorySiteCombo" prefHeight="25.0" prefWidth="132.0">
                <tooltip>
                    <Tooltip text="利用工場を切り替えます。計画／実績フォルダ・マスタ・受注ファイル等の環境変数既定と操作者選択が更新されます。"/>
                </tooltip>
            </ComboBox>
            <Label fx:id="shellOperatorUserLabel" styleClass="pm-muted-label" text="操作者: （未選択）"/>
            <Button fx:id="shellChangeSessionOperatorButton" mnemonicParsing="false"
                    onAction="#onShellChangeSessionOperatorAction" text="操作者変更"/>
            <Button fx:id="shellChangeOperatorPinButton" mnemonicParsing="false"
                    onAction="#onShellChangeOperatorPinAction" text="PIN変更"/>
            <Separator orientation="VERTICAL"/>
            <Label text="テーマ"/>
            <ComboBox fx:id="themeCombo" prefWidth="196.0"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="dispatchUsageGuideButton" mnemonicParsing="false" onAction="#onOpenDispatchUsageGuideDocxAction" text="配台の使い方"/>
            <Label fx:id="envVarsInitializedAtLabel" styleClass="pm-env-vars-initialized-at" text="環境変数初期化: —"/>
            <Separator orientation="VERTICAL"/>
            <HBox fx:id="shellStageProgressBox" alignment="CENTER_LEFT" managed="false" spacing="8.0" styleClass="pm-shell-stage-progress" visible="false">
                <Label fx:id="shellStageProgressLabel" minWidth="130.0" text="" />
                <ProgressIndicator fx:id="shellStageBusyIndicator" managed="false" prefHeight="22.0" prefWidth="22.0" visible="false" />
                <ProgressBar fx:id="shellStageProgressBar" managed="false" maxWidth="Infinity" prefWidth="220.0" visible="false" />
                <Button fx:id="shellStageCancelButton" managed="false" mnemonicParsing="false" onAction="#onCancelStageRunAction" text="中断" visible="false" />
            </HBox>
            <Region fx:id="toolbarGrowSpacer" maxWidth="Infinity" minWidth="0.0" />
        </ToolBar>
    </top>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="pm-global-status-bar">
            <padding>
                <Insets bottom="9.0" left="14.0" right="14.0" top="9.0"/>
            </padding>
            <Label fx:id="globalStatusMessageLabel" maxWidth="Infinity" styleClass="pm-global-status-message" text="準備完了"/>
            <ProgressIndicator fx:id="globalStatusProgressIndicator" managed="false" prefHeight="18.0" prefWidth="18.0" styleClass="pm-global-status-progress-indicator" visible="false"/>
            <ProgressBar fx:id="globalStatusProgressBar" managed="false" maxWidth="180.0" prefWidth="180.0" styleClass="pm-global-status-progress-bar" visible="false"/>
            <Region maxWidth="Infinity" minWidth="8.0" HBox.hgrow="ALWAYS"/>
            <Label fx:id="globalStatusTabLabel" styleClass="pm-global-status-meta" text="タブ: —"/>
            <Label fx:id="globalStatusOperatorLabel" styleClass="pm-global-status-meta" text="操作者: —"/>
            <Label fx:id="globalStatusFactoryLabel" styleClass="pm-global-status-meta" text="工場: —"/>
            <Label fx:id="globalStatusAttendanceLabel" styleClass="pm-global-status-meta" text="勤怠: —"/>
            <Label fx:id="globalStatusMemoryLabel" styleClass="pm-global-status-memory" text="Memory: …"/>
        </HBox>
    </bottom>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" tabDragPolicy="REORDER">
            <tabs>
                <Tab fx:id="mainShellTabEquipmentStatusDashboard" closable="false" text="ダッシュボード">
                    <content>
                        <fx:include fx:id="equipmentStatusDashboardTab" source="EquipmentStatusDashboardTab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="mainShellTabRun" closable="false" text="実行・ログ">
                    <content>
                        <fx:include fx:id="mainRunTab" source="MainRunTab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="mainShellTabPipelineExecutionTiming" closable="false" text="実行時間分析">
                    <content>
                        <fx:include fx:id="pipelineExecutionTimingTab" source="PipelineExecutionTimingTab.fxml"/>
                    </content>

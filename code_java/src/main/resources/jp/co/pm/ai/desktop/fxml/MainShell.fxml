                    </content>
                </Tab>
                <Tab fx:id="mainShellTabCacheHistory" closable="false" text="キャッシュ履歴">
                    <content>
                        <fx:include fx:id="workspaceCacheHistoryTab" source="WorkspaceCacheHistoryTab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="mainShellTabApiModelBenchmark" closable="false" text="APIモデルベンチマーク">
                    <content>
                        <fx:include fx:id="apiModelBenchmarkTab" source="ApiModelBenchmarkTab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="mainShellTabOrganizer" closable="false" text="タブ整理">
                    <content>
                        <fx:include fx:id="mainShellTabOrganizerPane" source="MainShellTabOrganizerTab.fxml"/>
                    </content>

                    </content>
                </Tab>
                <Tab fx:id="mainShellTabUserProfiles" closable="false" text="ユーザープロファイル">
                    <content>
                        <fx:include fx:id="userProfilesTab" source="UserProfilesTab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="mainShellTabOperatorUserManagement" closable="false" text="ユーザー管理者">
                    <content>

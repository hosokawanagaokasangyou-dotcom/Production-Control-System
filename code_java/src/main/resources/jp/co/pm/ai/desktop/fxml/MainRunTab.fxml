<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="pm-run-tab" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jp.co.pm.ai.desktop.MainRunTabController">
    <padding>
        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
    </padding>
    <top>
        <VBox fillWidth="true" spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="pm-run-header-bar">
                <StackPane fx:id="factoryLogoHost" alignment="CENTER" maxHeight="24.0" minHeight="22.0" minWidth="-1.0" prefHeight="22.0" prefWidth="-1.0" styleClass="pm-run-factory-logo-host">
                    <ImageView fx:id="factoryLogoImageView" fitHeight="18.0" fitWidth="72.0" mouseTransparent="true" preserveRatio="true" />
                    <Label fx:id="factoryLogoCaptionLabel" alignment="CENTER" contentDisplay="CENTER" maxWidth="80.0" mouseTransparent="true" styleClass="pm-run-factory-logo-caption" text="" textAlignment="CENTER" wrapText="false" />
                </StackPane>
                <ComboBox fx:id="factorySiteCombo" prefHeight="25.0" prefWidth="132.0">
                    <tooltip>
                        <Tooltip text="利用工場を切り替えます。計画／実績フォルダ・マスタ・受注ファイル等の環境変数既定と操作者選択が更新されます。" />
                    </tooltip>
                </ComboBox>
                <Label fx:id="operatorUserLabel" styleClass="pm-muted-label" text="操作者: （未選択）" />
                <Button fx:id="changeOperatorPinButton" mnemonicParsing="false" onAction="#onChangeOperatorPinAction" text="PIN変更" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Button mnemonicParsing="false" onAction="#onOpenDispatchUsageGuideDocxAction" text="配台の使い方" />
                    <Button mnemonicParsing="false" onAction="#onOpenDispatchRulesHtmlAction" text="配台ルール" />
                    <Button mnemonicParsing="false" onAction="#onOpenManualAction" text="マニュアルを開く" />
                    <Label fx:id="appVersionLabel" styleClass="pm-app-version-label" text="" />
                </HBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="pm-run-primary-bar">
                <StackPane fx:id="stage1NetworkCacheBadgeHost" alignment="CENTER_LEFT" managed="false" styleClass="pm-stage1-network-cache-badge-host" visible="false" />
                <Button fx:id="stage1RunButton" mnemonicParsing="false" onAction="#onStage1RunButtonAction" styleClass="pm-stage-run-button,pm-stage-run-1" text="段階1 実行" />
                <CheckBox fx:id="skipGeminiApiCheckBox" mnemonicParsing="false" selected="true" text="AI API 呼び出しをスキップ（開発用）">
                    <tooltip>
                        <Tooltip text="ON のとき Gemini への HTTP 呼び出しを行いません（段階1/2・配台不要ロジック等）。本番運用では必ず OFF にしてください。" />
                    </tooltip>
                </CheckBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="pm-run-book-open-inline">
                    <Label fx:id="masterWorkbookOpenHintLabel" text="master.xlsm" />
                    <Button mnemonicParsing="false" onAction="#onOpenMasterWorkbookAction" text="エクセルを開く" />
                    <Label fx:id="summaryWorkbookOpenHintLabel" text="サマリ_AI配台.xlsx" />
                    <Button fx:id="openSummaryAiDispatchButton" mnemonicParsing="false" onAction="#onOpenSummaryAiDispatchAction" text="エクセルを開く" />
                    <Button fx:id="openSummaryGenerationHistoryButton" mnemonicParsing="false" onAction="#onOpenSummaryGenerationHistoryAction" text="サマリ履歴" />
                    <Button fx:id="forceUnlockSummaryAiDispatchButton" disable="true" mnemonicParsing="false" onAction="#onForceUnlockSummaryExportLockAction" text="ロック解除" />
                </HBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="pm-run-log-toolbar">
                <Label text="種別" />
                <ComboBox fx:id="logFilterCombo" prefHeight="25.0" prefWidth="102.0" />
                <Label text="検索" />
                <TextField fx:id="logSearchField" maxWidth="Infinity" prefWidth="280.0" promptText="ログ行を部分一致で絞り込み（空欄ですべて表示）" HBox.hgrow="ALWAYS" />
                <Label text="フォント" />
                <ComboBox fx:id="logFontFamilyCombo" prefHeight="25.0" prefWidth="108.0" />
                <Label text="サイズ" />
                <ComboBox fx:id="logFontSizeCombo" prefWidth="88.0" />
                <Button fx:id="copyAllLogButton" mnemonicParsing="false" onAction="#onCopyAllLogButtonAction" text="全ログをコピー" />
                <Button fx:id="clearLogButton" mnemonicParsing="false" onAction="#onClearLogButtonAction" text="ログをクリア" />
            </HBox>
            <!-- workbookField / scriptDirField: セッション用。画面非表示。Python は環境変数 PM_AI_PYTHON のみ。 -->
            <HBox managed="false" spacing="0.0" visible="false">
                <TextField fx:id="workbookField" prefWidth="1.0" />
                <TextField fx:id="scriptDirField" prefWidth="1.0" />
            </HBox>
        </VBox>
    </top>
    <center>
        <ListView fx:id="logListView" minHeight="200.0" styleClass="pm-log-view" />
    </center>
    <bottom>
        <VBox fillWidth="true" spacing="8.0">
            <Accordion maxWidth="Infinity">
                <panes>
                    <TitledPane animated="true" expanded="false" text="その他（段階2・実行時間）">
                        <content>
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="320.0" minViewportHeight="120.0"
                                        prefViewportHeight="240.0" style="-fx-background-color: transparent;">
                                <VBox fillWidth="true" spacing="12.0" styleClass="pm-run-secondary-panel">
                                <Label styleClass="pm-section-title" text="段階2 成果物" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="段階2 Excel フォント" />
                                    <ComboBox fx:id="stage2ResultBookFontCombo" editable="true" prefWidth="220.0" />
                                </HBox>
                                <GridPane hgap="10.0" styleClass="pm-run-actions-grid" vgap="10.0">
                                    <Label text="production_plan（最新）" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0">
                                        <TextField fx:id="stage2ProductionPlanField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#onOpenStage2ProductionPlanAction" text="エクセルを開く" />
                                    </HBox>
                                    <Label text="member_schedule（最新）" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                        <TextField fx:id="stage2MemberScheduleField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#onOpenStage2MemberScheduleAction" text="エクセルを開く" />
                                    </HBox>
                                    <columnConstraints>
                                        <ColumnConstraints />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints />
                                        <RowConstraints />
                                    </rowConstraints>
                                </GridPane>
                                <Label styleClass="pm-section-title" text="加工速度" />
                                <VBox spacing="4.0">
                                    <CheckBox fx:id="applyLearnedSpeedFromActualsCheckBox" mnemonicParsing="false" selected="false"
                                              text="加工実績から収集した速度で「加工速度」列を上書きする" />
                                    <Label wrapText="true" text="OFF（既定）のとき master 等の速度のみ使用します。速度収集の不具合修正まで OFF 推奨。" />
                                </VBox>
                                <Label styleClass="pm-section-title" text="開発用" />
                                <VBox spacing="4.0">
                                    <CheckBox fx:id="stage1MarkAllExcludeAfterRunCheckBox" mnemonicParsing="false" selected="false" text="段階1実行後、全依頼を配台不要にする（開発用）" />
                                    <Label wrapText="true" text="ON のとき段階1正常終了後、配台計画_タスク入力の全行「配台不要」を yes にします。少数タスクだけ手動で外してから段階2を実行するデバッグ用途です。" />
                                </VBox>
                                <Label styleClass="pm-section-title" text="最新の実行時間" />
                                <GridPane hgap="16.0" styleClass="pm-run-execution-timings" vgap="4.0">
                                    <Label text="段階1" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label fx:id="pipelineTimingStage1Label" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label text="段階2.0" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <Label fx:id="pipelineTimingStage20Label" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                    <Label text="段階2.1" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                                    <Label fx:id="pipelineTimingStage21Label" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                                    <Label text="段階3.0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Label fx:id="pipelineTimingStage30Label" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="段階3.1" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <Label fx:id="pipelineTimingStage31Label" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                    <Label text="段階3.2" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                                    <Label fx:id="pipelineTimingStage32Label" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                                    <Label text="配台試行" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <Label fx:id="pipelineTimingDispatchTrialLabel" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="サマリ Excel" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                    <Label fx:id="pipelineTimingSummaryExcelLabel" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                    <Label text="納期管理ビュー" GridPane.columnIndex="4" GridPane.rowIndex="2" />
                                    <Label fx:id="pipelineTimingDeliveryCalendarLabel" styleClass="pm-run-timing-value" text="—" GridPane.columnIndex="5" GridPane.rowIndex="2" GridPane.columnSpan="1" />
                                </GridPane>
                                </VBox>
                            </ScrollPane>
                        </content>
                    </TitledPane>
                </panes>
            </Accordion>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label fx:id="statusLabel" text="exit: n/a — 0=OK / 1=error / 2=fatal / 3=PlanningValidationError / 9=cancel" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="prismPipelineLabel" styleClass="pm-prism-pipeline-label" text="JavaFX Prism: …" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

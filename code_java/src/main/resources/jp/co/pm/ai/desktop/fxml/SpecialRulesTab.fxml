<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jp.co.pm.ai.desktop.SpecialRulesTabController">
    <center>
        <TabPane fx:id="innerTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="要約">
                    <content>
                        <VBox spacing="8.0">
                            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
                            <HBox spacing="8">
                                <Button text="再読込" onAction="#onReloadMarkdownAction"/>
                                <Label fx:id="markdownPathLabel" wrapText="true" styleClass="pm-muted-label"/>
                            </HBox>
                            <TextArea fx:id="summaryBodyArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="列挙">
                    <content>
                        <VBox spacing="8.0">
                            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
                            <HBox spacing="8">
                                <Button text="再読込" onAction="#onReloadMarkdownAction"/>
                            </HBox>
                            <TextArea fx:id="enumeratedBodyArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="ルールビルダー">
                    <fx:include fx:id="builderTab" source="dispatch/rules/SpecialRulesBuilderTab.fxml"/>
                </Tab>
                <Tab text="ルール試走">
                    <fx:include fx:id="testLabTab" source="dispatch/rules/SpecialRulesTestLabTab.fxml"/>
                </Tab>
                <Tab text="適用トレース">
                    <fx:include fx:id="traceTab" source="dispatch/rules/SpecialRulesTraceTab.fxml"/>
                </Tab>
                <Tab text="工程優先">
                    <fx:include fx:id="processMachinePriorityTab"
                                source="dispatch/rules/ProcessMachinePriorityTab.fxml"/>
                </Tab>
                <Tab text="JSON">
                    <content>
                        <VBox spacing="8">
                            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
                            <HBox spacing="8">
                                <Button text="再読込" onAction="#onReloadJsonAction"/>
                                <Button text="保存" onAction="#onSaveJsonAction"/>
                            </HBox>
                            <TextArea fx:id="jsonBodyArea" style="-fx-font-family: monospace" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>

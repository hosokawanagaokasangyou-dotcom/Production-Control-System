<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jp.co.pm.ai.desktop.LearnedSpeedDataTabController"
      spacing="8.0" fillWidth="true">
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Button fx:id="refreshButton" mnemonicParsing="false" text="再読み込み"
                onAction="#onRefreshAction"/>
        <Label fx:id="archivePathLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Label fx:id="speedStorePathLabel" wrapText="true" style="-fx-font-size: 11px;"/>
    <TabPane fx:id="innerTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab closable="false" text="概要">
                <content>
                    <VBox spacing="8.0">
                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label fx:id="mlModeBadgeLabel" text="現在モード: off"/>
                            <Label fx:id="mlArchiveProgressLabel" text="アーカイブ job: 0 / 20"/>
                        </HBox>
                        <ProgressBar fx:id="mlArchiveProgressBar" maxWidth="Infinity" prefWidth="480.0" progress="0"/>
                        <Label fx:id="mlLadderLabel" wrapText="true"
                               text="[MVP] — [ML-0] — [ML-1] — [ML-2] — [ML-3]"/>
                        <Label fx:id="speedSummaryHeadlineLabel" wrapText="true"
                               text="速度キー: 0 件（適用可能: 0 件）"/>
                        <Label fx:id="readinessUpdatedAtLabel" wrapText="true" style="-fx-font-size: 11px;"/>
                    </VBox>
                </content>
            </Tab>
            <Tab closable="false" text="キー一覧">
                <content>
                    <VBox spacing="6.0">
                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                        </padding>
                        <TableView fx:id="speedKeyTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="speedKeyColumn" prefWidth="180.0" text="キー"/>
                                <TableColumn fx:id="speedProcessColumn" prefWidth="120.0" text="工程名"/>
                                <TableColumn fx:id="speedMachineColumn" prefWidth="160.0" text="機械名"/>
                                <TableColumn fx:id="speedSampleCountColumn" prefWidth="72.0" text="観測数"/>
                                <TableColumn fx:id="speedP50Column" prefWidth="88.0" text="p50 (m/分)"/>
                                <TableColumn fx:id="speedAppliedColumn" prefWidth="100.0" text="適用速度"/>
                            </columns>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
            <Tab closable="false" text="ヒストグラム">
                <content>
                    <VBox spacing="8.0">
                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                        </padding>
                        <Label fx:id="histogramDetailLabel" wrapText="true"/>
                        <BarChart fx:id="speedHistogramChart" animated="false" legendVisible="false"
                                  prefHeight="360.0" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis label="速度 (m/分)"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="件数"/>
                            </yAxis>
                        </BarChart>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>

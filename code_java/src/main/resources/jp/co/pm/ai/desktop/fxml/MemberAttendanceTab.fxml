<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jp.co.pm.ai.desktop.MemberAttendanceTabController"
      spacing="8.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <children>
        <ToolBar>
            <Label text="年"/>
            <Spinner fx:id="yearSpinner" editable="true" prefWidth="80.0"/>
            <Label text="月"/>
            <Spinner fx:id="monthSpinner" editable="true" prefWidth="60.0"/>
            <Button fx:id="syncButton" text="会社カレンダーに合わせる" onAction="#onSyncFromCompanyCalendar"/>
            <Button fx:id="exportMasterButton" text="master.xlsm に出力" onAction="#onExportMaster"/>
            <Button fx:id="refreshButton" text="状態更新" onAction="#onRefresh"/>
        </ToolBar>
        <Label fx:id="statusLabel" text=""/>
        <Label text="メンバー×日付の詳細グリッド編集は今後の拡張です。同期・JSON・master 出力は利用可能。" wrapText="true"/>
    </children>
</VBox>

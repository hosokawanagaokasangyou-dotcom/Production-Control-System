<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jp.co.pm.ai.desktop.MemberAttendanceTabController"
      spacing="12.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <children>
        <VBox fx:id="monthCalendarHost" spacing="4.0"/>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <ToolBar>
                <Label text="セル"/>
                <Spinner fx:id="cellSizeSpinner" editable="true" prefWidth="52.0"/>
                <Button fx:id="addMemberButton" text="メンバー追加" onAction="#onAddMember"/>
                <Button fx:id="editMemberButton" text="メンバー編集" onAction="#onEditMember"/>
                <Button fx:id="removeMemberButton" text="メンバー削除" onAction="#onRemoveMember"/>
                <Separator/>
                <Button fx:id="saveButton" text="保存" onAction="#onSave"/>
                <Button fx:id="setupButton" text="セットアップ" onAction="#onSetupWizard"/>
                <Button fx:id="restoreButton" text="世代から復元" onAction="#onRestoreFromHistory"/>
                <Separator/>
                <Button fx:id="openCalendarButton" text="勤怠・機械カレンダーを開く" onAction="#onOpenAttendanceCalendar"/>
                <Button fx:id="refreshButton" text="再読込" onAction="#onRefresh"/>
            </ToolBar>
            <Label fx:id="setupHintLabel" wrapText="true"
                   text="セットアップ: 祝日・週末取得 → メンバー勤怠を会社カレンダーに合わせる（対象はウィザード内の年月）"/>
            <VBox fx:id="gridHost" spacing="4.0" VBox.vgrow="ALWAYS"/>
            <VBox spacing="4.0" styleClass="pm-attendance-tab-status-footer">
                <VBox fx:id="statusHost" spacing="4.0"/>
                <Label fx:id="statusLabel" text=""/>
            </VBox>
        </VBox>
    </children>
</HBox>

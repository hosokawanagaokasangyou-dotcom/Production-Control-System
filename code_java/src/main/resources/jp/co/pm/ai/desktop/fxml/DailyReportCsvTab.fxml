<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jp.co.pm.ai.desktop.DailyReportCsvTabController" fillWidth="true" spacing="8.0">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Button fx:id="refreshButton" mnemonicParsing="false" text="再読込"
                onAction="#onRefreshButtonAction"/>
        <Button mnemonicParsing="false" text="列フィルタ・並べ替え解除"
                onAction="#onClearColumnFiltersAction"/>
        <Label text="検索文字列"/>
        <TextField fx:id="searchField" promptText="全列を横断検索（依頼NO・機械名・完了区分 等）"
                   prefWidth="280.0" HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel"/>
    </HBox>
    <Label fx:id="sourceLabel" wrapText="true" style="-fx-font-size: 10px;"/>
    <Label fx:id="metaLabel" wrapText="true" style="-fx-font-size: 10px;"/>
    <Label fx:id="hintLabel" wrapText="true" style="-fx-font-size: 10px;"/>
    <HBox fx:id="columnStripHost" alignment="CENTER_LEFT" spacing="0.0" maxWidth="Infinity"/>
    <StackPane fx:id="tableHost" minHeight="240.0" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" maxHeight="Infinity" maxWidth="Infinity"/>
    </StackPane>
</VBox>

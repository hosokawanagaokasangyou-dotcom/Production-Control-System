<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Dynamic table columns remain in {@link PlanInputStage3TabController}. -->

<VBox fillWidth="true" spacing="8.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jp.co.pm.ai.desktop.PlanInputStage3TabController">
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
    <TitledPane animated="true" expanded="true" text="操作・段階3">
        <content>
            <VBox fillWidth="true" spacing="6.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Button fx:id="stage30RunButton" mnemonicParsing="false" onAction="#onStage30RunButtonAction"
                            styleClass="pm-stage-run-button,pm-stage-run-3" text="段階3.0 実行" />
                    <Button fx:id="stage31RunButton" mnemonicParsing="false" onAction="#onStage31RunButtonAction"
                            styleClass="pm-stage-run-button,pm-stage-run-3" text="段階3.1(時間外)" />
                    <Button fx:id="stage32RunButton" mnemonicParsing="false" onAction="#onStage32RunButtonAction"
                            styleClass="pm-stage-run-button,pm-stage-run-3" text="段階3.2(数量厳守)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="reloadButton" mnemonicParsing="false" onAction="#onReloadButtonAction" text="入力3表を再読込" />
                    <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onSaveButtonAction" text="保存" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label minWidth="-Infinity" text="ファイル" />
                    <Label fx:id="pathLabel" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" />
                    <Label fx:id="statusLabel" wrapText="true" />
                </HBox>
                <HBox alignment="CENTER_LEFT" fx:id="tableOperationBar" spacing="6.0">
                    <Button mnemonicParsing="false" onAction="#onRowUpAction" prefWidth="36.0" text="↑" />
                    <Button mnemonicParsing="false" onAction="#onRowDownAction" prefWidth="36.0" text="↓" />
                    <Button fx:id="addRowButton" mnemonicParsing="false" onAction="#onAddRowButtonAction" text="行追加" />
                    <Button fx:id="removeRowsButton" mnemonicParsing="false" onAction="#onRemoveRowsButtonAction" text="行削除" />
                    <Button mnemonicParsing="false" onAction="#onClearColumnFiltersAction"
                            text="列フィルタ・並べ替え解除" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="既定列幅(px)" />
                    <TextField fx:id="colWidthField" maxWidth="72.0" prefWidth="72.0" promptText="112" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <HBox fx:id="columnStripHost" alignment="CENTER_LEFT" spacing="0.0" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
        </content>
    </TitledPane>
    <TitledPane animated="true" expanded="true" maxHeight="Infinity" text="データ表" VBox.vgrow="ALWAYS">
        <content>
            <VBox fillWidth="true">
                <Label fx:id="hintLabel" wrapText="true" />
                <Label fx:id="stage3ValidationWarningLabel" managed="false" visible="false" wrapText="true"
                       style="-fx-text-fill: #b71c1c; -fx-font-weight: bold;" />
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="行検索" />
                    <TextField fx:id="rowSearchField" maxWidth="Infinity" prefWidth="320.0" promptText="いずれかの列に含まれる文字列（部分一致）。空欄で列フィルタのみに戻る" HBox.hgrow="ALWAYS" />
                </HBox>
                <StackPane fx:id="spreadsheetHost" minHeight="240.0" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets bottom="8.0" left="8.0" right="8.0" />
                    </VBox.margin>
                </StackPane>
            </VBox>
        </content>
    </TitledPane>
</VBox>

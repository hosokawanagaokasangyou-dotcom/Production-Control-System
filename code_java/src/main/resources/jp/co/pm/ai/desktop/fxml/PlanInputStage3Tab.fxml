<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fillWidth="true" spacing="8.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jp.co.pm.ai.desktop.PlanInputStage3TabController">
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
    <TitledPane animated="true" expanded="true" text="操作・段階3">
        <content>
            <VBox fillWidth="true" spacing="8.0">
                <Label wrapText="true"
                       text="配台計画手動修正タブで「入力3表を生成」した枝番タスク（配台計画_タスク入力3.0 シート）を表示します。段階3.0/3.2 は入力3表を配台し、結果を元依頼NO単位へ統合します。" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="stage30RunButton" mnemonicParsing="false" onAction="#onStage30RunButtonAction"
                            styleClass="pm-stage-run-button,pm-stage-run-3" text="段階3.0 実行" />
                    <Button fx:id="stage31RunButton" mnemonicParsing="false" onAction="#onStage31RunButtonAction"
                            styleClass="pm-stage-run-button,pm-stage-run-3" text="段階3.1(時間外)" />
                    <Button fx:id="stage32RunButton" mnemonicParsing="false" onAction="#onStage32RunButtonAction"
                            styleClass="pm-stage-run-button,pm-stage-run-3" text="段階3.2(数量厳守)" />
                    <Button fx:id="reloadButton" mnemonicParsing="false" onAction="#onReloadButtonAction" text="入力3表を再読込" />
                </HBox>
                <Label fx:id="statusLabel" wrapText="true" />
            </VBox>
        </content>
    </TitledPane>
    <TitledPane animated="true" expanded="true" maxHeight="Infinity" text="入力3表（枝番タスク）" VBox.vgrow="ALWAYS">
        <content>
            <StackPane fx:id="tableHost" minHeight="240.0" VBox.vgrow="ALWAYS">
                <TableView fx:id="tableView" />
            </StackPane>
        </content>
    </TitledPane>
</VBox>

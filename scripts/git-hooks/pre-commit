#!/usr/bin/env bash
# Git pre-commit: UTF-8 チェック（*.md）→ version.txt バンプ（requires Python 3）。
# Windows Git Bash: bare python3 is often the Store stub; use scripts/run_python3.sh.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
RUN_PY="$ROOT/scripts/run_python3.sh"
if [[ ! -x "$RUN_PY" ]]; then
  chmod +x "$RUN_PY" "$ROOT/scripts/resolve_python3.sh" 2>/dev/null || true
fi
"$RUN_PY" "$ROOT/scripts/check_staged_markdown_utf8.py"
"$RUN_PY" "$ROOT/scripts/check_staged_ignored_log_paths.py"
VT="$ROOT/version.txt"
if [[ ! -f "$VT" ]]; then
  exit 0
fi
"$RUN_PY" "$ROOT/scripts/bump_version_txt.py" "$VT"
LAUNCHER_VT="$ROOT/code_java/src/main/resources/jp/co/pm/ai/desktop/rdp-launcher/PmAiRdpRemoteLauncher.version.txt"
if [[ -f "$LAUNCHER_VT" ]]; then
  cp "$VT" "$LAUNCHER_VT"
  git add -- "$VT" "$LAUNCHER_VT"
else
  git add -- "$VT"
fi
